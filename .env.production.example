# ============================================
# CONFIGURACIÓN DE ENTORNO — invLeo Backend
# PLANTILLA PARA PRODUCCIÓN
# Copia este archivo a .env.production y completa los valores reales.
# NUNCA subas tu .env.production real al repositorio.
# ============================================

# --- General ---
NODE_ENV=production
PORT=3000

# --- Base de datos (PostgreSQL / Supabase) ---
# Pooler de sesión (puerto 5432, recomendado) o host directo db.<ref>.supabase.co
DB_HOST=tu-host-de-produccion
DB_PORT=5432
DB_NAME=tu_db
DB_USER=tu_usuario
DB_PASSWORD=tu_password_seguro
# ⚠️  SSL OBLIGATORIO en producción. NUNCA poner 'false'.
DB_SSL=true

# --- JWT (autenticación) ---
# Usa un secreto largo y aleatorio (mínimo 256 bits). NUNCA el valor por defecto.
JWT_SECRET=CAMBIAR-POR-CLAVE
JWT_EXPIRES_IN=2d

# --- CORS / Frontend ---
FRONTEND_URL=https://tu-dominio-frontend.com
# Lista de orígenes permitidos, separados por coma (sin espacios).
ALLOWED_ORIGINS=https://tu-dominio-frontend.com

# --- Redis (caché - opcional) ---
# REDIS_ENABLED=false  → desactiva la caché por completo
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# --- Límites de planes (SaaS) ---
PLAN_FREE_MAX_USERS=2
PLAN_FREE_MAX_PRODUCTS=50
PLAN_FREE_MAX_CASH_REGISTERS=1
PLAN_BASIC_MAX_USERS=5
PLAN_BASIC_MAX_PRODUCTS=500
PLAN_BASIC_MAX_CASH_REGISTERS=2
PLAN_PRO_MAX_USERS=15
PLAN_PRO_MAX_PRODUCTS=5000
PLAN_PRO_MAX_CASH_REGISTERS=5
PLAN_ENTERPRISE_MAX_USERS=100
PLAN_ENTERPRISE_MAX_PRODUCTS=50000
PLAN_ENTERPRISE_MAX_CASH_REGISTERS=20

# --- Facturación / ciclos y precios (en centavos) ---
BILLING_CYCLE_BASIC_DAYS=30
BILLING_CYCLE_PRO_DAYS=30
BILLING_CYCLE_ENTERPRISE_DAYS=30
BILLING_GRACE_PERIOD_DAYS=3
BILLING_PRICE_BASIC_CENTS=0
BILLING_PRICE_PRO_CENTS=0
BILLING_PRICE_ENTERPRISE_CENTS=0

# --- ePayco (pasarela de pagos) ---
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_CUST_ID=
EPAYCO_P_KEY=
EPAYCO_BASE_URL=
EPAYCO_CONFIRMATION_URL=
EPAYCO_REDIRECT_URL=
EPAYCO_TEST_MODE=false
# NUNCA poner 'true' en producción (bypass de seguridad del webhook)
EPAYCO_SKIP_WEBHOOK_SIGNATURE_VALIDATION=false
