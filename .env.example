# Environment Configuration
NODE_ENV=development
PORT=3000

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invleo_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
