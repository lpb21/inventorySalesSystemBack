# ============================================
# CONFIGURACIÓN DE ENTORNO — invLeo Backend
# PLANTILLA GENÉRICA (valores de referencia)
#
# Convención de archivos por entorno (la app carga el archivo según NODE_ENV):
#   .env.development  → desarrollo
#   .env.test         → tests
#   .env.production   → producción (solo en el servidor)
#   .env              → fallback genérico (legacy)
#
# Copia este archivo al que corresponda y completa los valores.
# NUNCA subas tus .env reales al repositorio.
# ============================================

# --- General ---
NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL / Supabase) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invleo_db
DB_USER=postgres
DB_PASSWORD=your_password_here
# DB_SSL=false  → sin SSL (desarrollo local). Omítelo o ponlo distinto de 'false' en producción (Supabase requiere SSL)
DB_SSL=false

# --- JWT (autenticación) ---
# En producción, usa un secreto largo y aleatorio. NUNCA el valor por defecto.
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=2d

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:5173
# Lista de orígenes permitidos, separados por coma (sin espacios). Ej: https://app.tudominio.com,https://admin.tudominio.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Redis (caché - opcional) ---
# REDIS_ENABLED=false  → desactiva la caché por completo
REDIS_URL=redis://localhost:6379
REDIS_TTL=300

# --- Límites de planes (SaaS) ---
PLAN_FREE_MAX_USERS=2
PLAN_FREE_MAX_PRODUCTS=50
PLAN_FREE_MAX_CASH_REGISTERS=1
PLAN_BASIC_MAX_USERS=5
PLAN_BASIC_MAX_PRODUCTS=500
PLAN_BASIC_MAX_CASH_REGISTERS=2
PLAN_PRO_MAX_USERS=15
PLAN_PRO_MAX_PRODUCTS=5000
PLAN_PRO_MAX_CASH_REGISTERS=5
PLAN_ENTERPRISE_MAX_USERS=100
PLAN_ENTERPRISE_MAX_PRODUCTS=50000
PLAN_ENTERPRISE_MAX_CASH_REGISTERS=20

# --- Facturación / ciclos y precios (en centavos) ---
BILLING_CYCLE_BASIC_DAYS=30
BILLING_CYCLE_PRO_DAYS=30
BILLING_CYCLE_ENTERPRISE_DAYS=30
BILLING_GRACE_PERIOD_DAYS=3
BILLING_PRICE_BASIC_CENTS=0
BILLING_PRICE_PRO_CENTS=0
BILLING_PRICE_ENTERPRISE_CENTS=0

# --- ePayco (pasarela de pagos) ---
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_CUST_ID=
EPAYCO_P_KEY=
EPAYCO_BASE_URL=
EPAYCO_CONFIRMATION_URL=
EPAYCO_REDIRECT_URL=
EPAYCO_TEST_MODE=true
# EPAYCO_SKIP_WEBHOOK_SIGNATURE_VALIDATION=false  → NUNCA poner 'true' en producción (bypass de seguridad del webhook)
EPAYCO_SKIP_WEBHOOK_SIGNATURE_VALIDATION=false

# --- Imágenes de productos (S3 + CloudFront) ---
# Sin S3_BUCKET la subida de imágenes responde 503 y el autocompletado queda apagado.
# Credenciales: rol IAM de la instancia EC2 (NO poner llaves de AWS aquí).
S3_BUCKET=
S3_REGION=us-east-1
# URL pública de CloudFront (sin / final). Si se deja vacío se usa la URL directa del bucket.
CDN_BASE_URL=
# PRODUCT_IMAGE_MAX_UPLOAD_BYTES=5242880
# PRODUCT_IMAGE_SIZE=512
# PRODUCT_IMAGE_QUALITY=75
# PRODUCT_IMAGE_MAX_CONCURRENT=2

# --- Open Food Facts (imágenes por código de barras) ---
# OFF exige un User-Agent propio: "NombreApp/Versión (email de contacto)"
OFF_USER_AGENT=PuntoFresco/1.0 (tu-email@dominio.com)
# OFF_ENABLED=true
# OFF_TIMEOUT_MS=3000
# OFF_MIN_INTERVAL_MS=700
