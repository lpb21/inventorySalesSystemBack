{
  "name": "sisinventariosback",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "dev": "node --watch src/server.js",
    "build": "echo 'API Ready for production'",
    "deploy:prepare": "bash prepare-production.sh",
    "deploy:start": "pm2 start ecosystem.config.js && pm2 startup && pm2 save",
    "deploy:stop": "pm2 stop ecosystem.config.js",
    "deploy:logs": "pm2 logs invleo-api",
    "deploy:status": "pm2 status",
    "health": "curl http://localhost/health || curl http://localhost:3000/health",
    "db:sync": "node src/config/sync.js",
    "db:seed": "node src/config/seed.js"
  },
  "author": "LeonardoParra",
  "license": "ISC",
  "description": "invLeo - Sistema de Gestión de Inventarios para Salsamentarías (SaaS)",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "postgres": "^3.4.8",
    "redis": "^5.11.0",
    "sequelize": "^6.35.2",
    "uuid": "^9.0.1"
  }
}
